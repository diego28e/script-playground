# Copy to infra/lab/.env on the server (chmod 600). Never commit the real file.

# Students sign in with their Academia del Código account. Create the hub's client on the platform at
# /admin/lab-access with the callback URL below, and paste its client ID and secret here.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_CALLBACK_URL=https://lab.academiadelcodigo.com/hub/oauth_callback
LAB_PLATFORM_URL=https://academiadelcodigo.com
# Only when the hub's container can't reach LAB_PLATFORM_URL itself, e.g. a lab on your computer talking to a
# platform on localhost: http://host.docker.internal:3000
# LAB_PLATFORM_INTERNAL_URL=

# Host port the hub listens on (127.0.0.1 only). nginx/lab.conf proxies to 8000; change both together.
LAB_HUB_PORT=8000

# Who gets in comes from the platform: anyone enrolled in a published course, and platform admins as lab
# admins. These optional email lists add accounts on top (e.g. a break-glass admin); leave them empty.
LAB_ALLOWED_USERS=
LAB_ADMIN_USERS=

# Running student servers at once. 1 while the platform has one student.
LAB_MAX_ACTIVE_SERVERS=1

# Each student's container. Lower these when you raise the limit (about 4G and 1 CPU each on this server).
LAB_IMAGE=lab-lc-mastery:2026-10-19
LAB_MEM_LIMIT=12G
LAB_CPU_LIMIT=3
LAB_PIDS_LIMIT=512

# Seconds without activity before a student's server is stopped.
LAB_IDLE_TIMEOUT=3600
