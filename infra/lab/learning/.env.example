# The learning service's settings. Copy to .env next to this file (git-ignored) and fill in.

# The platform's database (the same as the platform's DATABASE_URL): the tutor reads lessons and progress and
# keeps its sessions, memory and request ledger there.
DATABASE_URL=

# The platform's Gemini key (project script-builder, free tier).
GEMINI_API_KEY=

# DeepSeek, the tutor's paid last fallback (lib/ai/gemini.ts TUTOR_CHAIN). Leave empty to skip it.
DEEPSEEK_API_KEY=

# Deepgram, the tutor's voice (docs/voice.md): the microphone conversation and replies read aloud. A key with Member
# permission or higher (it mints the browser's 30-second tokens; an admin key also reads the credit balance). Leave
# empty to turn voice off: the panel says it isn't set up.
DEEPGRAM_API_KEY=
