# The practice worker's settings. Copy to .env next to this file (git-ignored) and fill in.

# The platform's database (the same as the platform's DATABASE_URL): it reads the jobs the admin page starts and writes
# the tasks and drafts.
DATABASE_URL=

# The models that write tasks and draft lessons (lib/ai/gemini.ts AUTHORING_CHAIN): Claude first, then DeepSeek, then
# the free Gemini models. The same keys as the platform's.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# The grader that proves code tasks. Inside the lab it's the grader container itself; the secret is the same
# GRADER_SECRET as in grader/.env and in Amplify.
GRADER_URL=http://grader:8080
GRADER_SECRET=
