generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String              @unique
  emailVerified      Boolean?
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  role               Role                @default(USER)
  accounts           Account[]
  sessions           Session[]
  submissions        Submission[]
  enrollments        Enrollment[]
  lessonProgress     LessonProgress[]
  // OpenID Connect provider (the lab hub signs in through the platform): see the oauth models below.
  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]
  // The AI tutor (docs/ai-tutor.md).
  tutorProfile       TutorProfile?
  tutorSessions      TutorSession[]
  learnerMemory      LearnerMemory[]
  practiceRequests   PracticeRequest[]
  practiceLearners   PracticeLearner[]

  @@map("user")
}

model Session {
  id                 String              @id @default(cuid())
  userId             String
  token              String              @unique
  expiresAt          DateTime
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  idToken               String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Challenge {
  id           String       @id @default(cuid())
  title        String
  slug         String       @unique
  description  Json
  starterCode  String
  solutionCode String?
  order        Int          @default(0)
  difficulty   Difficulty   @default(EASY)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  submissions  Submission[]
  labels       Label[]

  @@map("challenge")
}

model Submission {
  id          String           @id @default(cuid())
  userId      String
  challengeId String
  code        String
  status      SubmissionStatus
  output      String?
  error       String?
  createdAt   DateTime         @default(now())
  challenge   Challenge        @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("submission")
}

model Label {
  id         String      @id @default(cuid())
  name       String
  color      String      @default("#000000")
  challenges Challenge[]

  @@map("label")
}

// Courses are imported from their own repositories (scripts/import-course.ts): modules and lessons are matched by
// slug on every import and updated in place, so a student's progress survives a re-import.
model Course {
  id               String                   @id @default(cuid())
  slug             String                   @unique
  title            String
  summary          String?
  // The language the course's content is written in (BCP 47), e.g. "en".
  language         String                   @default("en")
  status           CourseStatus             @default(DRAFT)
  sourceRepoUrl    String?
  // The commit the course was last imported from.
  sourceRef        String?
  importedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  modules          CourseModule[]
  enrollments      Enrollment[]
  // The practice engine's skill graph (docs/practice.md).
  practiceSkills   PracticeSkill[]
  skillGraphs      SkillGraphVersion[]
  practiceTasks    PracticeTask[]
  practiceLearners PracticeLearner[]
  foundSkills      PracticeFoundSkill[]
  discoveredEdges  PracticeDiscoveredEdge[]

  @@map("course")
}

model CourseModule {
  id            String   @id @default(cuid())
  courseId      String
  slug          String
  position      Int
  title         String
  goals         String?
  estimatedTime String?
  // A grouping inside the course, e.g. "Part 1 — Core".
  part          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons       Lesson[]

  @@unique([courseId, slug])
  @@index([courseId, position])
  @@map("course_module")
}

model Lesson {
  id               String               @id @default(cuid())
  moduleId         String
  slug             String
  position         Int
  // The course's own numbering, e.g. "01.04".
  code             String?
  title            String
  kind             LessonKind
  estimatedTime    String?
  // Upper bound of estimatedTime, for totals.
  estimatedMinutes Int?
  prerequisites    String?
  objectives       String[]             @default([])
  // Repository-relative path of the lesson's file. A NOTEBOOK or PROJECT lesson opens it in the lab.
  sourcePath       String?
  // Markdown body of a READING lesson.
  body             String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  module           CourseModule         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress         LessonProgress[]
  videoUploads     VideoUpload[]
  videos           LessonVideoPart[]
  tutorSessions    TutorSession[]
  practiceSkills   PracticeSkill[]
  practiceDraft    PracticeLessonDraft?

  @@unique([moduleId, slug])
  @@index([moduleId, position])
  @@map("lesson")
}

enum LessonVideoSource {
  // Uploaded from the admin page.
  UPLOAD
  // The course repository's NN-MM-slug.video.json sidecar, written by every import.
  REPOSITORY
}

// A lesson's videos (docs/lesson-videos.md), in teaching order: as a rule one per skill of the lesson, a short tutorial
// each. Learners see them as the lesson's playlist.
model LessonVideoPart {
  id              String            @id @default(cuid())
  lessonId        String
  position        Int
  // The skill it teaches: a PracticeSkill key of the course. Its label is the video's title unless it has its own.
  skillKey        String?
  titleEs         String?
  titleEn         String?
  // lk-core's video (lib/lesson-video.ts): a plain media object, or an interactive item group with its quizzes.
  video           Json
  source          LessonVideoSource @default(UPLOAD)
  durationSeconds Float?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  lesson          Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  uploads         VideoUpload[]

  @@index([lessonId, position])
  @@map("lesson_video_part")
}

// A video uploaded from the admin page (/admin/videos, actions/videos.ts): the original goes to S3 under uploads/,
// MediaConvert writes the web version under outputPrefix, and when it is ready it replaces the video it was uploaded
// for (partId) or becomes a new video of the lesson (for skillKey, or with its own title).
model VideoUpload {
  id              String            @id @default(cuid())
  lessonId        String
  partId          String?
  skillKey        String?
  titleEs         String?
  titleEn         String?
  status          VideoUploadStatus @default(UPLOADING)
  fileName        String
  // S3 key of the original (deleted once encoded; the bucket also expires uploads/ after 7 days).
  sourceKey       String
  // S3 prefix the encoded files land under, e.g. courses/<course>/<lesson>/<upload id>/.
  outputPrefix    String
  posterKey       String?
  // [{ kind, srclang, label, default, key }], the caption files uploaded with the video.
  captions        Json              @default("[]")
  // As the browser reported them: the displayed size and the length.
  width           Int?
  height          Int?
  durationSeconds Float?
  jobId           String?
  // MediaConvert's percentage while encoding.
  percent         Int?
  error           String?
  createdById     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  lesson          Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  part            LessonVideoPart?  @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@index([lessonId, createdAt])
  @@map("video_upload")
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollment")
}

model LessonProgress {
  id           String         @id @default(cuid())
  userId       String
  lessonId     String
  status       ProgressStatus @default(IN_PROGRESS)
  startedAt    DateTime       @default(now())
  completedAt  DateTime?
  lastViewedAt DateTime       @default(now())
  // The lesson's videos, for this learner, by video id: where to resume, the quiz answers, when finished
  // (actions/lessons.ts VideoState).
  videoState   Json?
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

// ── AI requests: the ledger, and the count the free-tier quota is read from (lib/ai/quota.ts) ──────────────────
// One row per request to Gemini, written before the call (PENDING) so concurrent calls count, and completed with
// the tokens after. `day` is the Pacific date, the day Google's daily quotas use.
model AiRequest {
  id             String          @id @default(cuid())
  pool           AiPool
  feature        String
  model          String
  userId         String?
  status         AiRequestStatus @default(PENDING)
  day            String
  inputTokens    Int             @default(0)
  outputTokens   Int             @default(0)
  // Thinking tokens, billed as output.
  thoughtTokens  Int             @default(0)
  // What the call would cost at the paid rates, in millionths of a dollar. The key is on the free tier today,
  // so this is what the free tier saves, and what a billed project would pay.
  listCostMicros Int             @default(0)
  traceId        String
  createdAt      DateTime        @default(now())

  @@index([day, model, pool])
  @@index([model, createdAt])
  @@index([userId, day])
  @@map("ai_request")
}

enum AiPool {
  // The tutor in the lab.
  TUTOR
  // The platform's other AI features (challenges, translation).
  PLATFORM
  // Admins' content work: drafting the practice skill graph, and later writing practice tasks.
  AUTHORING
}

enum AiRequestStatus {
  PENDING
  OK
  FAILED
}

// ── The AI tutor (docs/ai-tutor.md) ────────────────────────────────────────────────────────────────────────────
// What the tutor keeps per learner across sessions: the help mode they chose.
model TutorProfile {
  userId    String    @id
  mode      TutorMode @default(GUIDE)
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tutor_profile")
}

enum TutorMode {
  GUIDE
  SHOW
}

// One conversation about one notebook. `state` is the harness's (lib/tutor/state.ts): the micro-steps of the
// current objective, the hint levels given per step, and the goal stack of detours.
model TutorSession {
  id           String         @id @default(cuid())
  userId       String
  lessonId     String?
  notebookPath String
  state        Json           @default("{}")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  messages     TutorMessage[]

  @@index([userId, notebookPath, updatedAt])
  @@map("tutor_session")
}

model TutorMessage {
  id        String       @id @default(cuid())
  sessionId String
  role      String
  // ask, explain_error, suggest_fix or reply.
  kind      String
  content   String
  // The tool calls the tutor made with this reply, as the harness applied them.
  actions   Json?
  model     String?
  traceId   String?
  createdAt DateTime     @default(now())
  session   TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("tutor_message")
}

// A fact the tutor learned about a learner. A newer fact on the same subject supersedes the old one, which is kept
// with `supersededAt` set: the learner's history, the way a temporal knowledge graph keeps it.
model LearnerMemory {
  id              String     @id @default(cuid())
  userId          String
  kind            MemoryKind
  subject         String
  fact            String
  skill           String?
  sourceSessionId String?
  validFrom       DateTime   @default(now())
  supersededAt    DateTime?
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, supersededAt])
  @@map("learner_memory")
}

enum MemoryKind {
  PREFERENCE
  MISCONCEPTION
  STRENGTH
  STRUGGLE
}

// A skill the learner agreed to practise after a detour; the practice engine (milestone 10) schedules it.
model PracticeRequest {
  id           String           @id @default(cuid())
  userId       String
  skill        String
  evidence     PracticeEvidence
  lessonId     String?
  sessionId    String?
  // What the tutor and the learner said around it (the detour's challenge, the last messages): what the practice
  // skill and its tasks are written from (lib/practice/tutor-requests.ts).
  detail       Json?
  // Resolved on the learner's next practice visit: to a course skill ("course"), a skill made for it ("found"), or
  // nothing that fits ("none"); the skill's key.
  resolution   String?
  resolvedKey  String?
  resolvedAt   DateTime?
  resolveTries Int              @default(0)
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("practice_request")
}

enum PracticeEvidence {
  // The learner passed the detour's challenge.
  PASSED
  // The learner skipped the detour ("I know this").
  SKIPPED
  // The learner asked for more practice on it (the tutor's offer_practice), outside a detour's end.
  REQUESTED
}

enum Role {
  USER
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum LessonKind {
  VIDEO
  NOTEBOOK
  READING
  PRACTICE
  PROJECT
}

enum VideoUploadStatus {
  UPLOADING
  ENCODING
  READY
  FAILED
}

enum ProgressStatus {
  IN_PROGRESS
  COMPLETED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  PENDING
  PASSED
  FAILED
}

// --- OpenID Connect provider ----------------------------------------------------------------------------
// Tables of Better Auth's jwt plugin and @better-auth/oauth-provider 1.7.16 (lib/auth.ts), field for field as
// the installed plugins define them. The platform is the identity provider for the lab hub: the hub is the one
// client (an admin creates it at /admin/lab-access), and lab access is the `groups` claim (lib/lab-access.ts).

// Signing keys for ID tokens.
model Jwks {
  id         String    @id @default(cuid())
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String                @id @default(cuid())
  clientId                         String                @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]              @default([])
  userId                           String?
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         Json?
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  resources                        OauthClientResource[]
  refreshTokens                    OauthRefreshToken[]
  accessTokens                     OauthAccessToken[]
  consents                         OauthConsent[]

  @@index([userId])
  @@map("oauth_client")
}

model OauthResource {
  id                            String                @id @default(cuid())
  identifier                    String                @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?                  @default(1)
  metadata                      Json?
  clients                       OauthClientResource[]

  @@map("oauth_resource")
}

model OauthClientResource {
  id         String        @id @default(cuid())
  clientId   String
  resourceId String
  metadata   Json?
  createdAt  DateTime?
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauth_client_resource")
}

model OauthRefreshToken {
  id                      String             @id @default(cuid())
  token                   String             @unique
  clientId                String
  sessionId               String?
  userId                  String
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime?
  createdAt               DateTime?
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens            OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_token")
}

model OauthAccessToken {
  id                      String             @id @default(cuid())
  token                   String?            @unique
  clientId                String
  sessionId               String?
  userId                  String?
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?
  expiresAt               DateTime?
  createdAt               DateTime?
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh                 OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id                      String      @id @default(cuid())
  clientId                String
  userId                  String?
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime?
  updatedAt               DateTime?
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}

// One row per private_key_jwt assertion, so each is used once. Unused by the lab (it authenticates with a secret).
model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauth_client_assertion")
}

// ---------------------------------------------------------------------------------------------------------------
// The practice engine's skill graph (docs/practice.md). An admin drafts each lesson's skills with a model, edits and
// approves them on /admin/practice, then publishes: a SkillGraphVersion snapshots the approved skills and their
// prerequisites as an lk-practice graph, which learners' practice is planned against.
// ---------------------------------------------------------------------------------------------------------------

// lk-practice's two default ladders: declarative (recognise, recall, produce, apply) and procedural (example,
// complete, write, transfer).
enum SkillKnowledge {
  DECLARATIVE
  PROCEDURAL
}

// HARD: the skill is locked until the prerequisite is mastered. SOFT: practised first when both are due.
enum SkillEdgeStrength {
  HARD
  SOFT
}

enum SkillDraftStatus {
  DRAFTED
  APPROVED
}

// A skill in the working graph, taught by one lesson.
model PracticeSkill {
  id            String              @id @default(cuid())
  courseId      String
  lessonId      String
  // The graph's id for it: kebab-case, unique in the course, kept across versions so learners' history follows it.
  key           String
  labelEs       String
  labelEn       String
  descriptionEs String
  descriptionEn String
  knowledge     SkillKnowledge
  // Code tasks can practise it offline: plain Python and the course's packages, no network or API keys. When false,
  // it gets recall tasks only.
  runnable      Boolean             @default(true)
  // How a grader can tell this skill apart in an answer (lk-practice's criteriaHint).
  criteriaHint  String?
  // Order within the lesson.
  position      Int
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  course        Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson        Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  // Edges where this skill is the prerequisite, and where it needs one.
  requiredBy    PracticeSkillEdge[] @relation("EdgeFrom")
  requires      PracticeSkillEdge[] @relation("EdgeTo")

  @@unique([courseId, key])
  @@index([lessonId, position])
  @@map("practice_skill")
}

// `from` must be learned before `to`.
model PracticeSkillEdge {
  id        String            @id @default(cuid())
  fromId    String
  toId      String
  strength  SkillEdgeStrength
  // The drafting model's reason, for the reviewer.
  reason    String?
  createdAt DateTime          @default(now())
  from      PracticeSkill     @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        PracticeSkill     @relation("EdgeTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId])
  @@map("practice_skill_edge")
}

// A lesson's place in the review: drafted by a model, then approved by an admin. Only approved lessons are published.
model PracticeLessonDraft {
  id           String           @id @default(cuid())
  lessonId     String           @unique
  status       SkillDraftStatus @default(DRAFTED)
  // The model that wrote the draft, and its trace in the logs.
  model        String?
  traceId      String?
  draftedAt    DateTime         @default(now())
  approvedAt   DateTime?
  approvedById String?
  lesson       Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("practice_lesson_draft")
}

// A published graph: the approved skills and prerequisites at that moment, as lk-practice's SkillGraph (version
// "<course slug>@<version>") plus each skill's labels and lesson. Never edited; the next publish adds a version.
model SkillGraphVersion {
  id            String   @id @default(cuid())
  courseId      String
  version       Int
  graph         Json
  skillCount    Int
  edgeCount     Int
  publishedAt   DateTime @default(now())
  publishedById String?
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, version])
  @@map("skill_graph_version")
}

// A practice task in a skill's pool (docs/practice.md, "Tasks"): written by a model for one skill and stage, then
// proven before any learner sees it (code: the reference passes on the grader and wrong code fails; questions: a
// second model answers it blind and agrees with the key). Rejected candidates are kept with their reason, to tune the
// prompt. Tasks follow the skill's key, so they survive new graph versions.
enum PracticeTaskStatus {
  PROVEN
  REJECTED
  RETIRED
}

model PracticeTask {
  id              String             @id @default(cuid())
  courseId        String
  skillKey        String
  // A stage of the skill's ladder (recognise, recall, produce, apply; example, complete, write, transfer).
  stage           String
  // choice, fill, predict, code or debug.
  form            String
  // lk-practice's difficulty, in logits relative to the stage (about -1 easy to +1 hard).
  difficulty      Float              @default(0)
  expectedSeconds Int
  // What the learner sees and the key (lib/practice/tasks.ts TaskContent), in Spanish and English.
  content         Json
  // The lk-practice item once proven (status "proven", with its proof); null while rejected.
  item            Json?
  status          PracticeTaskStatus
  rejectReason    String?
  // The model that wrote it, and the call's trace in the logs.
  model           String
  traceId         String?
  contentHash     String
  // An admin's edit makes a new task (proven again) and retires this one: the task it replaced.
  editedFromId    String?
  createdAt       DateTime           @default(now())
  course          Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  answers         PracticeAnswer[]
  hints           PracticeHint[]

  @@unique([courseId, contentHash])
  @@index([courseId, skillKey, stage, status])
  @@map("practice_task")
}

// A learner's practice in one course (docs/practice.md, "A session"). lk-practice's state is a cache of the log: the
// log is the truth, and a new graph version is applied by replaying it.
model PracticeLearner {
  id           String              @id @default(cuid())
  userId       String
  courseId     String
  // The published graph version the state is built on.
  graphVersion Int
  state        Json
  // This learner's confirmed missing prerequisites (lk-practice DiscoveryExtension[]): their graph is the published
  // one composed with these (docs/practice.md, "Missing prerequisites").
  extensions   Json                @default("[]")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  log          PracticeLogEntry[]
  sessions     PracticeSession[]
  diagnoses    PracticeDiagnosis[]

  @@unique([userId, courseId])
  @@map("practice_learner")
}

// lk-practice's append-only log (ReviewLogEntry), in order.
model PracticeLogEntry {
  id        String          @id @default(cuid())
  learnerId String
  seq       Int
  entry     Json
  at        DateTime
  learner   PracticeLearner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([learnerId, seq])
  @@map("practice_log_entry")
}

// One day's practice for a learner: the planned tasks, in order. "A few more" after the daily set is another session
// marked extra.
model PracticeSession {
  id          String           @id @default(cuid())
  learnerId   String
  // The learner's own date (YYYY-MM-DD, in their time zone).
  day         String
  extra       Boolean          @default(false)
  // [{ targetId, taskId, skillKey, stage, kind }] (lib/practice/learner.ts SessionItem).
  items       Json
  createdAt   DateTime         @default(now())
  completedAt DateTime?
  learner     PracticeLearner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  answers     PracticeAnswer[]
  hints       PracticeHint[]

  @@index([learnerId, day])
  @@map("practice_session")
}

// A learner's answer to one task, with what the page showed them back.
model PracticeAnswer {
  id         String          @id @default(cuid())
  sessionId  String
  taskId     String
  answer     Json
  passed     Boolean
  score      Float
  durationMs Int
  // The grading the learner saw: tests and their messages, output, or the key.
  result     Json
  createdAt  DateTime        @default(now())
  session    PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  task       PracticeTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([sessionId, taskId])
  @@map("practice_answer")
}

// Missing prerequisites (docs/practice.md): when a learner fails a skill twice in a row, a model names the
// prerequisites that may be missing, and lk-practice tests each with short probes.

enum PracticeDiagnosisStatus {
  PENDING
  RUNNING
  // At least one hypothesis opened.
  OPENED
  // The model found nothing missing, or nothing it proposed passed the checks.
  NONE
  FAILED
}

// One diagnosis of a failed skill: asked for after the answer, run by the practice page in the background.
model PracticeDiagnosis {
  id         String                  @id @default(cuid())
  learnerId  String
  // The failed answer's evidence id (the practice answer's id).
  evidenceId String                  @unique
  skillKey   String
  stage      String
  taskId     String
  status     PracticeDiagnosisStatus @default(PENDING)
  model      String?
  // What the model proposed: accepted ones with lk-practice's hypothesis id, rejected ones with the check's codes.
  proposals  Json?
  error      String?
  createdAt  DateTime                @default(now())
  finishedAt DateTime?
  learner    PracticeLearner         @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId, createdAt])
  @@map("practice_diagnosis")
}

// A skill the course doesn't teach that a diagnosis named (key "found.<name>"), shared by the course's learners so
// its tasks are written once.
model PracticeFoundSkill {
  id            String           @id @default(cuid())
  courseId      String
  key           String
  labelEs       String
  labelEn       String
  descriptionEs String
  descriptionEn String
  knowledge     SkillKnowledge
  runnable      Boolean          @default(true)
  // lk-practice's SkillNode for it, as hypotheses carry it (its content is part of their ids).
  node          Json
  // The lesson of the skill it was first found for: where the map and the task writer place it.
  lessonId      String
  // Who found it: a practice diagnosis, or the tutor (a detour or a learner asking for practice).
  origin        FoundSkillOrigin @default(DIAGNOSIS)
  // For a tutor's skill, what the tutor's challenge looked like: its tasks are written in the same spirit.
  context       String?
  createdAt     DateTime         @default(now())
  course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, key])
  @@map("practice_found_skill")
}

enum FoundSkillOrigin {
  DIAGNOSIS
  TUTOR
}

enum DiscoveredEdgeStatus {
  PROPOSED
  // Added to the course's own graph (a skill and a prerequisite on /admin/practice; published with the next version).
  ADDED
  // Not proposed again.
  DISMISSED
}

// A prerequisite a diagnosis proposed (from -> to), with how its probes went across learners.
model PracticeDiscoveredEdge {
  id        String               @id @default(cuid())
  courseId  String
  fromKey   String
  toKey     String
  status    DiscoveredEdgeStatus @default(PROPOSED)
  // The first model's reason, shown to the admin.
  rationale String?
  opened    Int                  @default(0)
  confirmed Int                  @default(0)
  refuted   Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  course    Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, fromKey, toKey])
  @@map("practice_discovered_edge")
}

// A hint a learner asked for on a task before answering it (docs/practice.md, "Hints"): at most three a task, each
// more specific than the last. Their number goes into the answer's evidence (lk-practice's hintsUsed).
model PracticeHint {
  id        String          @id @default(cuid())
  sessionId String
  taskId    String
  // 1, 2 or 3.
  number    Int
  text      String
  model     String
  createdAt DateTime        @default(now())
  session   PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  task      PracticeTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([sessionId, taskId, number])
  @@map("practice_hint")
}

// Python Compass (docs/compass.md): a card for each Python concept learners meet in the course, grounded in the official
// docs and proven on the grader, and the signals that show which cards learners need most. `language` is "python" for
// now; the same tables hold other languages' concepts later.

enum CompassCardStatus {
  // Written (by a model or by hand), not proven yet.
  DRAFT
  // Its examples ran on the grader as the card says; waiting for the admin's review.
  PROVEN
  // Learners see it (one published version per concept).
  PUBLISHED
  // Replaced by a newer version, or taken down.
  RETIRED
}

enum CompassSignalKind {
  // A search: what was typed, and whether it found anything (a search that found nothing says what to write next).
  SEARCH
  CARD_VIEW
  // "Explain this line" on a construct.
  EXPLAIN_LINE
  // A learner's code raised (scratchbook, code tasks): the error type, and the concept on the failing line.
  RUN_ERROR
  // A question to the guide's AI.
  ASK
  // A practice answer missed on a task that practises the concept.
  PRACTICE_MISS
}

// One concept the detector knows (lib/compass/detector.py), with what the course asks of it.
model CompassConcept {
  id          String        @id @default(cuid())
  language    String        @default("python")
  // The detector's key, stable across versions: "f-string", "dict-get", "stdlib:json".
  key         String
  group       String
  labelEs     String
  labelEn     String
  // From the course inventory (scripts/compass-inventory.py): the cards' starting order, how many lessons teach with
  // it, and the lesson where it first appears.
  usageRank   Int?
  lessonCount Int           @default(0)
  firstLesson String?
  // From learners' signals, recomputed: how much learners need it. It re-ranks the cards over time.
  demand      Float         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  cards       CompassCard[]

  @@unique([language, key])
  @@index([language, usageRank])
  @@map("compass_concept")
}

// A version of a concept's card. An edit makes a new version, proven again; publishing it retires the previous one.
model CompassCard {
  id            String            @id @default(cuid())
  conceptId     String
  version       Int
  status        CompassCardStatus @default(DRAFT)
  // The Python version its examples ran on and its links point to (the lab's).
  pythonVersion String            @default("3.12")
  // What the learner reads, in Spanish and English: title, one-line summary, the explanation (Markdown), when to reach
  // for it, and the LangChain lessons where it shows up.
  content       Json
  // Runnable examples (the code and the output it must print) and common mistakes (code that must fail with the error
  // the card names), all checked on the grader.
  examples      Json
  // Official docs links, each one in the docs index (lib/compass/python-docs-<version>.json): never an invented URL.
  docs          Json
  // Concept keys it builds on and leads to.
  related       String[]
  // The grader's results for its examples and mistakes, when proven.
  proof         Json?
  // Who wrote this version: a model id, or "admin".
  author        String
  reviewedById  String?
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  concept       CompassConcept    @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([conceptId, version])
  @@index([status])
  @@map("compass_card")
}

// What learners do and where they struggle, collected from day one so the cards can be ranked by need, not guesses.
// Counted, never shown by name.
model CompassSignal {
  id         String            @id @default(cuid())
  kind       CompassSignalKind
  // The learner, when signed in: to count distinct learners.
  userId     String?
  language   String            @default("python")
  conceptKey String?
  // What was searched or asked (trimmed), or the error type of a RUN_ERROR.
  text       String?
  // A search that found nothing.
  empty      Boolean           @default(false)
  // Where it happened: "scratchbook", "practice", "lesson", "guide".
  surface    String?
  courseId   String?
  createdAt  DateTime          @default(now())

  @@index([kind, createdAt])
  @@index([conceptKey, kind])
  @@map("compass_signal")
}
