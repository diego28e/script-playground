generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(cuid())
  name           String?
  email          String           @unique
  emailVerified  Boolean?
  image          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  role           Role             @default(USER)
  accounts       Account[]
  sessions       Session[]
  submissions    Submission[]
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  // OpenID Connect provider (the lab hub signs in through the platform): see the oauth models below.
  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  idToken               String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Challenge {
  id           String       @id @default(cuid())
  title        String
  slug         String       @unique
  description  Json
  starterCode  String
  solutionCode String?
  order        Int          @default(0)
  difficulty   Difficulty   @default(EASY)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  submissions  Submission[]
  labels       Label[]

  @@map("challenge")
}

model Submission {
  id          String           @id @default(cuid())
  userId      String
  challengeId String
  code        String
  status      SubmissionStatus
  output      String?
  error       String?
  createdAt   DateTime         @default(now())
  challenge   Challenge        @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("submission")
}

model Label {
  id         String      @id @default(cuid())
  name       String
  color      String      @default("#000000")
  challenges Challenge[]

  @@map("label")
}

// Courses are imported from their own repositories (scripts/import-course.ts): modules and lessons are matched by
// slug on every import and updated in place, so a student's progress survives a re-import.
model Course {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  summary       String?
  // The language the course's content is written in (BCP 47), e.g. "en".
  language      String         @default("en")
  status        CourseStatus   @default(DRAFT)
  sourceRepoUrl String?
  // The commit the course was last imported from.
  sourceRef     String?
  importedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  modules       CourseModule[]
  enrollments   Enrollment[]

  @@map("course")
}

model CourseModule {
  id            String   @id @default(cuid())
  courseId      String
  slug          String
  position      Int
  title         String
  goals         String?
  estimatedTime String?
  // A grouping inside the course, e.g. "Part 1 — Core".
  part          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons       Lesson[]

  @@unique([courseId, slug])
  @@index([courseId, position])
  @@map("course_module")
}

model Lesson {
  id               String           @id @default(cuid())
  moduleId         String
  slug             String
  position         Int
  // The course's own numbering, e.g. "01.04".
  code             String?
  title            String
  kind             LessonKind
  estimatedTime    String?
  // Upper bound of estimatedTime, for totals.
  estimatedMinutes Int?
  prerequisites    String?
  objectives       String[]         @default([])
  // Repository-relative path of the lesson's file. A NOTEBOOK or PROJECT lesson opens it in the lab.
  sourcePath       String?
  // Markdown body of a READING lesson.
  body             String?
  // An lk-core item group with its media timeline, for VIDEO lessons.
  video            Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  module           CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress         LessonProgress[]
  videoUploads     VideoUpload[]

  @@unique([moduleId, slug])
  @@index([moduleId, position])
  @@map("lesson")
}

// A video uploaded from the admin page (/admin/videos, actions/videos.ts): the original goes to S3 under uploads/,
// MediaConvert writes the web version under outputPrefix, and when it is ready the lesson's video points at it.
model VideoUpload {
  id              String            @id @default(cuid())
  lessonId        String
  status          VideoUploadStatus @default(UPLOADING)
  fileName        String
  // S3 key of the original (deleted once encoded; the bucket also expires uploads/ after 7 days).
  sourceKey       String
  // S3 prefix the encoded files land under, e.g. courses/<course>/<lesson>/<upload id>/.
  outputPrefix    String
  posterKey       String?
  // [{ kind, srclang, label, default, key }], the caption files uploaded with the video.
  captions        Json              @default("[]")
  // As the browser reported them: the displayed size and the length.
  width           Int?
  height          Int?
  durationSeconds Float?
  jobId           String?
  // MediaConvert's percentage while encoding.
  percent         Int?
  error           String?
  createdById     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  lesson          Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, createdAt])
  @@map("video_upload")
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollment")
}

model LessonProgress {
  id           String         @id @default(cuid())
  userId       String
  lessonId     String
  status       ProgressStatus @default(IN_PROGRESS)
  startedAt    DateTime       @default(now())
  completedAt  DateTime?
  lastViewedAt DateTime       @default(now())
  // The lesson video, for this learner: where to resume and the quiz answers (actions/lessons.ts VideoState).
  videoState   Json?
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

enum Role {
  USER
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum LessonKind {
  VIDEO
  NOTEBOOK
  READING
  PRACTICE
  PROJECT
}

enum VideoUploadStatus {
  UPLOADING
  ENCODING
  READY
  FAILED
}

enum ProgressStatus {
  IN_PROGRESS
  COMPLETED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  PENDING
  PASSED
  FAILED
}


// --- OpenID Connect provider ----------------------------------------------------------------------------
// Tables of Better Auth's jwt plugin and @better-auth/oauth-provider 1.7.16 (lib/auth.ts), field for field as
// the installed plugins define them. The platform is the identity provider for the lab hub: the hub is the one
// client (an admin creates it at /admin/lab-access), and lab access is the `groups` claim (lib/lab-access.ts).

// Signing keys for ID tokens.
model Jwks {
  id         String    @id @default(cuid())
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String                @id @default(cuid())
  clientId                         String                @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]              @default([])
  userId                           String?
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         Json?
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  resources                        OauthClientResource[]
  refreshTokens                    OauthRefreshToken[]
  accessTokens                     OauthAccessToken[]
  consents                         OauthConsent[]

  @@index([userId])
  @@map("oauth_client")
}

model OauthResource {
  id                            String                @id @default(cuid())
  identifier                    String                @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?                  @default(1)
  metadata                      Json?
  clients                       OauthClientResource[]

  @@map("oauth_resource")
}

model OauthClientResource {
  id         String        @id @default(cuid())
  clientId   String
  resourceId String
  metadata   Json?
  createdAt  DateTime?
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauth_client_resource")
}

model OauthRefreshToken {
  id                      String             @id @default(cuid())
  token                   String             @unique
  clientId                String
  sessionId               String?
  userId                  String
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime?
  createdAt               DateTime?
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens            OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_token")
}

model OauthAccessToken {
  id                      String             @id @default(cuid())
  token                   String?            @unique
  clientId                String
  sessionId               String?
  userId                  String?
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?
  expiresAt               DateTime?
  createdAt               DateTime?
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh                 OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id                      String      @id @default(cuid())
  clientId                String
  userId                  String?
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime?
  updatedAt               DateTime?
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}

// One row per private_key_jwt assertion, so each is used once. Unused by the lab (it authenticates with a secret).
model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauth_client_assertion")
}
