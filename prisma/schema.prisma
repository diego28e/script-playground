generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String              @unique
  emailVerified      Boolean?
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  role               Role                @default(USER)
  accounts           Account[]
  sessions           Session[]
  submissions        Submission[]
  enrollments        Enrollment[]
  lessonProgress     LessonProgress[]
  // OpenID Connect provider (the lab hub signs in through the platform): see the oauth models below.
  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]
  // The AI tutor (docs/ai-tutor.md).
  tutorProfile       TutorProfile?
  tutorSessions      TutorSession[]
  learnerMemory      LearnerMemory[]
  practiceRequests   PracticeRequest[]
  practiceLearners   PracticeLearner[]
  // Conversations with the voice teachers (docs/voice-context.md).
  voiceConversations VoiceConversation[]
  learnerProfiles    LearnerProfile[]
  // Lessons taken on the whiteboard (docs/whiteboard.md).
  boardSessions      BoardSession[]
  // The learner's own instructions for how to teach them (docs/whiteboard-teaching.md §2).
  preferences        LearnerPreference[]

  @@map("user")
}

model Session {
  id                 String              @id @default(cuid())
  userId             String
  token              String              @unique
  expiresAt          DateTime
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  idToken               String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Challenge {
  id           String       @id @default(cuid())
  title        String
  slug         String       @unique
  description  Json
  starterCode  String
  solutionCode String?
  order        Int          @default(0)
  difficulty   Difficulty   @default(EASY)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  submissions  Submission[]
  labels       Label[]

  @@map("challenge")
}

model Submission {
  id          String           @id @default(cuid())
  userId      String
  challengeId String
  code        String
  status      SubmissionStatus
  output      String?
  error       String?
  createdAt   DateTime         @default(now())
  challenge   Challenge        @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("submission")
}

model Label {
  id         String      @id @default(cuid())
  name       String
  color      String      @default("#000000")
  challenges Challenge[]

  @@map("label")
}

// Courses are imported from their own repositories (scripts/import-course.ts): modules and lessons are matched by
// slug on every import and updated in place, so a student's progress survives a re-import.
model Course {
  id               String                   @id @default(cuid())
  slug             String                   @unique
  title            String
  summary          String?
  // The language the course's content is written in (BCP 47), e.g. "en".
  language         String                   @default("en")
  status           CourseStatus             @default(DRAFT)
  // Who may see a published course (lib/course-access.ts, docs/private-courses.md): everyone, or only the people on
  // its access list (and admins).
  visibility       CourseVisibility         @default(PUBLIC)
  access           CourseAccess[]
  // The widgets beside this course's practice (docs/practice.md, "Widgets"), switched in Admin → Courses: the Python
  // scratchbook, for courses whose tasks are code, and the voice coach, to talk a task through out loud.
  practiceScratchbook Boolean               @default(true)
  practiceVoice    Boolean                  @default(false)
  // The language of the course's code practice (lib/practice/language.ts): "python" or "typescript". It picks the
  // scratchbook's language and the one new code tasks are written in; a task keeps the language it was written in.
  practiceLanguage String                   @default("python")
  // Audio and video lessons pause where the learner has a step to do on their own computer (docs/lesson-stops.md),
  // switched in Admin → Stops. Off until the course's stops have been generated and reviewed.
  lessonStops      Boolean                  @default(false)
  // A reading lesson's "## Solutions" section, to the end of the lesson, is folded behind "Show solutions" on its page
  // (docs/lesson-solutions.md), switched in Admin → Courses. For courses that are practised by not reading
  // the solution first, such as the interview challenges.
  foldSolutions    Boolean                  @default(false)
  sourceRepoUrl    String?
  // The commit the course was last imported from.
  sourceRef        String?
  importedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  modules          CourseModule[]
  enrollments      Enrollment[]
  // The practice engine's skill graph (docs/practice.md).
  practiceSkills   PracticeSkill[]
  skillGraphs      SkillGraphVersion[]
  practiceTasks    PracticeTask[]
  practiceLearners PracticeLearner[]
  foundSkills      PracticeFoundSkill[]
  discoveredEdges  PracticeDiscoveredEdge[]
  // Bulk practice work the server's worker carries out (docs/practice.md, "Jobs").
  practiceJobs     PracticeJob[]
  // Lessons taken on the whiteboard (docs/whiteboard.md).
  boardSessions    BoardSession[]

  @@map("course")
}

// A learner's conversation with a voice teacher (docs/voice-context.md): the lesson tutor ("Ask the teacher", about one
// lesson) or the practice coach ("Talk it through", about one course's practice). Kept so they can come back to it, and
// so the teacher's context is built on the server from what was really said, not from what a browser sends.
model VoiceConversation {
  id           String         @id @default(cuid())
  userId       String
  // "lesson" or "practice": which teacher, and what the conversation is scoped to.
  kind         String
  courseId     String
  lessonId     String?
  // The first thing the learner asked, shortened: how the conversation is listed.
  title        String?
  // Compaction: what the turns up to summarySeq come to, as a structured note for the model (lib/voice/context.ts).
  // The turns themselves stay; this is derived from them and can be made again.
  summary      String?
  summarySeq   Int            @default(0)
  // The learner profile has learned from the messages up to this one (lib/voice/profile.ts).
  profileSeq   Int            @default(0)
  messageCount Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     VoiceMessage[]

  @@index([userId, kind, lessonId, updatedAt])
  @@index([userId, kind, courseId, updatedAt])
  @@map("voice_conversation")
}

// What the voice teachers know about a learner beyond one conversation (docs/voice-context.md, "The learner profile"):
// notes a model writes from the learner's conversations, which both teachers read. Two rows a learner: scope "all"
// (how they like to learn, for every course) and one per course (what they know, what is shaky, their misconceptions).
// Derived from the conversations; the learner can read it and forget it from the voice sheet.
model LearnerProfile {
  id        String   @id @default(cuid())
  userId    String
  // "all", or a course's id.
  scope     String
  notes     String
  // How many times it has been rewritten from new conversation.
  updates   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope])
  @@map("learner_profile")
}

// One thing said in a conversation, in order. Text only: a reply is read aloud again from its text when asked.
model VoiceMessage {
  id             String            @id @default(cuid())
  conversationId String
  // 1, 2, 3… within the conversation.
  seq            Int
  // "learner" or "teacher".
  role           String
  text           String
  // ok; interrupted (the learner cut the reply off, or left, before it ended); failed (no reply came).
  status         String            @default("ok")
  // Learner: { spoken, at (the lesson's moment, s), taskId }. Teacher: { model, traceId, tokens, context: the size of
  // each layer the model was given } (lib/voice/context.ts, "Measuring").
  meta           Json?
  createdAt      DateTime          @default(now())
  conversation   VoiceConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, seq])
  @@map("voice_message")
}

// A platform-wide setting an admin changes from the dashboard (lib/settings.ts): one row per key, its value as JSON.
// The first ones are the AI explainers' voice (lib/voice/explainer.ts).
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("platform_setting")
}

// One person who may open a private course, by the email they sign in with. The email is stored lower-cased, and may
// be added before the person has an account: they see the course from their first sign-in.
model CourseAccess {
  id        String   @id @default(cuid())
  courseId  String
  email     String
  // The admin who added it (a user id).
  addedById String?
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, email])
  @@index([email])
  @@map("course_access")
}

model CourseModule {
  id            String   @id @default(cuid())
  courseId      String
  slug          String
  position      Int
  title         String
  goals         String?
  estimatedTime String?
  // A grouping inside the course, e.g. "Part 1 — Core".
  part          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons       Lesson[]

  @@unique([courseId, slug])
  @@index([courseId, position])
  @@map("course_module")
}

model Lesson {
  id               String               @id @default(cuid())
  moduleId         String
  slug             String
  position         Int
  // The course's own numbering, e.g. "01.04".
  code             String?
  title            String
  kind             LessonKind
  estimatedTime    String?
  // Upper bound of estimatedTime, for totals.
  estimatedMinutes Int?
  prerequisites    String?
  objectives       String[]             @default([])
  // Repository-relative path of the lesson's file. A NOTEBOOK or PROJECT lesson opens it in the lab.
  sourcePath       String?
  // Markdown body of a READING lesson.
  body             String?
  // A fingerprint of what the lesson says (title, objectives, and its guide or notebook), set by the import, and when
  // an import last found it different: practice skills drafted before then may no longer match the lesson
  // (docs/practice.md, "When a lesson changes").
  contentHash      String?
  contentChangedAt DateTime?
  // Set when an import no longer finds the lesson in the repository; it's kept, with learners' progress.
  missingSince     DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  module           CourseModule         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress         LessonProgress[]
  videoUploads     VideoUpload[]
  videos           LessonVideoPart[]
  tutorSessions    TutorSession[]
  practiceSkills   PracticeSkill[]
  practiceDraft    PracticeLessonDraft?
  // The lesson told as audio by a teacher (docs/lesson-audio.md).
  audio            LessonAudio?
  stops            LessonStop[]
  boardSessions    BoardSession[]

  @@unique([moduleId, slug])
  @@index([moduleId, position])
  @@map("lesson")
}

// A moment in a lesson's audio or one of its videos where the learner has something to do on their own computer
// (docs/lesson-stops.md): the player pauses there and shows the step, with its exact commands, until they continue.
// Written by a model from the recording's timed transcript and the lesson's text, reviewed in Admin → Stops.
model LessonStop {
  id         String   @id @default(cuid())
  lessonId   String
  // Which recording: "audio" (the lesson's audio) or "video:<LessonVideoPart id>".
  media      String
  // Seconds into the recording: just after the sentence that gives the instruction.
  at         Float
  titleEs    String
  titleEn    String
  stepEs     String
  stepEn     String
  // The exact commands, each as the lesson writes it (checked against the lesson's text when generated).
  commands   String[] @default([])
  // The model that wrote it, or "admin" for one added or edited by hand.
  author     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, media, at])
  @@map("lesson_stop")
}

enum LessonVideoSource {
  // Uploaded from the admin page.
  UPLOAD
  // The course repository's NN-MM-slug.video.json sidecar, written by every import.
  REPOSITORY
}

// A lesson's videos (docs/lesson-videos.md), in teaching order: as a rule one per skill of the lesson, a short tutorial
// each. Learners see them as the lesson's playlist.
model LessonVideoPart {
  id              String            @id @default(cuid())
  lessonId        String
  position        Int
  // The skill it teaches: a PracticeSkill key of the course. Its label is the video's title unless it has its own.
  skillKey        String?
  titleEs         String?
  titleEn         String?
  // lk-core's video (lib/lesson-video.ts): a plain media object, or an interactive item group with its quizzes.
  video           Json
  source          LessonVideoSource @default(UPLOAD)
  durationSeconds Float?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  lesson          Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  uploads         VideoUpload[]

  @@index([lessonId, position])
  @@map("lesson_video_part")
}

// A video uploaded from the admin page (/admin/videos, actions/videos.ts): the original goes to S3 under uploads/,
// MediaConvert writes the web version under outputPrefix, and when it is ready it replaces the video it was uploaded
// for (partId) or becomes a new video of the lesson (for skillKey, or with its own title).
model VideoUpload {
  id              String            @id @default(cuid())
  lessonId        String
  partId          String?
  skillKey        String?
  titleEs         String?
  titleEn         String?
  status          VideoUploadStatus @default(UPLOADING)
  fileName        String
  // S3 key of the original (deleted once encoded; the bucket also expires uploads/ after 7 days).
  sourceKey       String
  // S3 prefix the encoded files land under, e.g. courses/<course>/<lesson>/<upload id>/.
  outputPrefix    String
  posterKey       String?
  // [{ kind, srclang, label, default, key }], the caption files uploaded with the video.
  captions        Json              @default("[]")
  // As the browser reported them: the displayed size and the length.
  width           Int?
  height          Int?
  durationSeconds Float?
  jobId           String?
  // MediaConvert's percentage while encoding.
  percent         Int?
  error           String?
  createdById     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  lesson          Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  part            LessonVideoPart?  @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@index([lessonId, createdAt])
  @@map("video_upload")
}

enum LessonAudioStatus {
  // Waiting for the practice worker to write the script.
  SCRIPT_QUEUED
  WRITING
  // Written: waiting for an admin to read it and approve it.
  REVIEW
  // Approved (or written in a run that voices without review): waiting to be voiced.
  VOICE_QUEUED
  VOICING
  // Voiced: learners hear it.
  DONE
  // A step failed on every attempt; `error` says which and why.
  FAILED
}

// A lesson's audio (docs/lesson-audio.md): a model writes what a teacher would say to explain the whole lesson
// (lib/lesson-audio/script.ts), an admin approves the script, and Deepgram voices it (lib/lesson-audio/voice.ts). The
// practice worker does both steps, one lesson at a time, in queue order (`priority` first, then `queuedAt`). Learners
// hear `audioPath` whenever it is set: rewriting or re-voicing replaces it only when the new audio is ready.
model LessonAudio {
  id            String            @id @default(cuid())
  lessonId      String            @unique
  status        LessonAudioStatus @default(SCRIPT_QUEUED)
  // What the steps use: the script model (lib/lesson-audio/script.ts NARRATION_MODELS) and the Deepgram voice.
  model         String
  voice         String
  // Voice right after writing, without waiting for review (a run started with "voice them too").
  autoVoice     Boolean           @default(false)
  // Before an expressive voice (ElevenLabs v4) reads it, a model adds delivery to the script: audio tags for tone and
  // pauses, and emphasis, never changing a word (lib/lesson-audio/delivery.ts).
  delivery      Boolean           @default(true)
  // A lesson asked for on its own goes before a whole-course run.
  priority      Int               @default(0)
  queuedAt      DateTime?
  attempts      Int               @default(0)
  notBefore     DateTime?
  startedAt     DateTime?
  // What the worker is doing right now ("Writing part 2 of 5"), or the last reason a step will be retried.
  progress      String?
  error         String?
  script        String?
  scriptModel   String?
  scriptWords   Int?
  scriptedAt    DateTime?
  approvedAt    DateTime?
  approvedById  String?
  // The voiced lesson: a /media/ path (lib/media.ts), its length, the script it says, and how many characters were
  // voiced (what Deepgram bills).
  audioPath     String?
  audioSeconds  Float?
  audioScript   String?
  audioChars    Int?
  audioVoice    String?
  // What the voice actually read: the script with the delivery added, when it was.
  audioDirected String?
  voicedAt      DateTime?
  // Bumped on every voicing: part of the file's name, so a new version never meets an old one in a cache.
  revision      Int               @default(0)
  // When each word of audioScript is said (lib/lesson-audio/timing.ts), so the transcript follows the audio:
  // {v, matched, words: [start in centiseconds per word]}. Worked out by the worker after every voicing.
  timings       Json?
  timingTries   Int               @default(0)
  timingError   String?
  requestedById String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  lesson        Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([status, priority, queuedAt])
  @@map("lesson_audio")
}

// One billable call to a voice provider (docs/voice-spend.md): ElevenLabs or Deepgram, written the moment the call
// returns, failed calls included, by whatever made it (the platform, the practice worker, the lab's learning service).
// With the provider's own id for the call, so Admin → Spend can match it against what the provider says the platform's
// key did and billed, and flag any call the platform didn't make. No foreign keys: a charge outlives what it was for.
model ProviderCharge {
  id              String   @id @default(cuid())
  // "elevenlabs" | "deepgram"
  provider        String
  // What it was for (lib/spend/charges.ts WORKLOADS), e.g. "lesson-audio.voice", "tutor.listen".
  workload        String
  model           String?
  // "ok" | "failed"
  status          String
  // Characters sent to a text-to-speech call; audio seconds transcribed, or produced when known.
  characters      Int      @default(0)
  audioSeconds    Float?
  // Our estimate at list price when the call was made, in millionths of a dollar. What was billed comes from the provider.
  estimatedMicros Int      @default(0)
  // ElevenLabs' x-trace-id, or Deepgram's request id.
  requestId       String?
  // Where it was made: "platform" (Amplify), "worker" (the practice worker), "lab" (the learning service).
  runtime         String
  userId          String?
  courseId        String?
  lessonId        String?
  audioId         String?
  videoPartId     String?
  voice           String?
  detail          Json?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([provider, createdAt])
  @@index([requestId])
  @@map("provider_charge")
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollment")
}

model LessonProgress {
  id           String         @id @default(cuid())
  userId       String
  lessonId     String
  status       ProgressStatus @default(IN_PROGRESS)
  startedAt    DateTime       @default(now())
  completedAt  DateTime?
  lastViewedAt DateTime       @default(now())
  // The lesson's videos, for this learner, by video id: where to resume, the quiz answers, when finished
  // (actions/lessons.ts VideoState).
  videoState   Json?
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

// ── AI requests: the ledger, and the count the free-tier quota is read from (lib/ai/quota.ts) ──────────────────
// One row per request to Gemini, written before the call (PENDING) so concurrent calls count, and completed with
// the tokens after. `day` is the Pacific date, the day Google's daily quotas use.
model AiRequest {
  id             String          @id @default(cuid())
  pool           AiPool
  feature        String
  model          String
  userId         String?
  status         AiRequestStatus @default(PENDING)
  day            String
  inputTokens    Int             @default(0)
  outputTokens   Int             @default(0)
  // Thinking tokens, billed as output.
  thoughtTokens  Int             @default(0)
  // What the call would cost at the paid rates, in millionths of a dollar. The key is on the free tier today,
  // so this is what the free tier saves, and what a billed project would pay.
  listCostMicros Int             @default(0)
  traceId        String
  createdAt      DateTime        @default(now())

  @@index([day, model, pool])
  @@index([model, createdAt])
  @@index([userId, day])
  @@map("ai_request")
}

enum AiPool {
  // The tutor in the lab.
  TUTOR
  // The platform's other AI features (challenges, translation).
  PLATFORM
  // Admins' content work: drafting the practice skill graph, and later writing practice tasks.
  AUTHORING
}

enum AiRequestStatus {
  PENDING
  OK
  FAILED
}

// ── The AI tutor (docs/ai-tutor.md) ────────────────────────────────────────────────────────────────────────────
// What the tutor keeps per learner across sessions: the help mode they chose.
model TutorProfile {
  userId    String    @id
  mode      TutorMode @default(GUIDE)
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tutor_profile")
}

enum TutorMode {
  GUIDE
  SHOW
}

// One conversation about one notebook. `state` is the harness's (lib/tutor/state.ts): the micro-steps of the
// current objective, the hint levels given per step, and the goal stack of detours.
model TutorSession {
  id           String         @id @default(cuid())
  userId       String
  lessonId     String?
  notebookPath String
  state        Json           @default("{}")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  messages     TutorMessage[]

  @@index([userId, notebookPath, updatedAt])
  @@map("tutor_session")
}

model TutorMessage {
  id        String       @id @default(cuid())
  sessionId String
  role      String
  // ask, explain_error, suggest_fix or reply.
  kind      String
  content   String
  // The tool calls the tutor made with this reply, as the harness applied them.
  actions   Json?
  model     String?
  traceId   String?
  createdAt DateTime     @default(now())
  session   TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("tutor_message")
}

// A fact the tutor learned about a learner. A newer fact on the same subject supersedes the old one, which is kept
// with `supersededAt` set: the learner's history, the way a temporal knowledge graph keeps it.
model LearnerMemory {
  id              String     @id @default(cuid())
  userId          String
  kind            MemoryKind
  subject         String
  fact            String
  skill           String?
  sourceSessionId String?
  validFrom       DateTime   @default(now())
  supersededAt    DateTime?
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, supersededAt])
  @@map("learner_memory")
}

enum MemoryKind {
  PREFERENCE
  MISCONCEPTION
  STRENGTH
  STRUGGLE
}

// A skill the learner agreed to practise after a detour; the practice engine (milestone 10) schedules it.
model PracticeRequest {
  id           String           @id @default(cuid())
  userId       String
  skill        String
  evidence     PracticeEvidence
  lessonId     String?
  sessionId    String?
  // What the tutor and the learner said around it (the detour's challenge, the last messages): what the practice
  // skill and its tasks are written from (lib/practice/tutor-requests.ts).
  detail       Json?
  // Resolved on the learner's next practice visit: to a course skill ("course"), a skill made for it ("found"), or
  // nothing that fits ("none"); the skill's key.
  resolution   String?
  resolvedKey  String?
  resolvedAt   DateTime?
  resolveTries Int              @default(0)
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("practice_request")
}

enum PracticeEvidence {
  // The learner passed the detour's challenge.
  PASSED
  // The learner skipped the detour ("I know this").
  SKIPPED
  // The learner asked for more practice on it (the tutor's offer_practice), outside a detour's end.
  REQUESTED
}

enum Role {
  USER
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum CourseVisibility {
  // Anyone sees it in the catalog and can enrol.
  PUBLIC
  // Only the people on its access list, and admins. For everyone else it doesn't exist.
  PRIVATE
}

enum LessonKind {
  VIDEO
  NOTEBOOK
  READING
  PRACTICE
  PROJECT
}

enum VideoUploadStatus {
  UPLOADING
  ENCODING
  READY
  FAILED
}

enum ProgressStatus {
  IN_PROGRESS
  COMPLETED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  PENDING
  PASSED
  FAILED
}

// --- OpenID Connect provider ----------------------------------------------------------------------------
// Tables of Better Auth's jwt plugin and @better-auth/oauth-provider 1.7.16 (lib/auth.ts), field for field as
// the installed plugins define them. The platform is the identity provider for the lab hub: the hub is the one
// client (an admin creates it at /admin/lab-access), and lab access is the `groups` claim (lib/lab-access.ts).

// Signing keys for ID tokens.
model Jwks {
  id         String    @id @default(cuid())
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String                @id @default(cuid())
  clientId                         String                @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]              @default([])
  userId                           String?
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         Json?
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  resources                        OauthClientResource[]
  refreshTokens                    OauthRefreshToken[]
  accessTokens                     OauthAccessToken[]
  consents                         OauthConsent[]

  @@index([userId])
  @@map("oauth_client")
}

model OauthResource {
  id                            String                @id @default(cuid())
  identifier                    String                @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?                  @default(1)
  metadata                      Json?
  clients                       OauthClientResource[]

  @@map("oauth_resource")
}

model OauthClientResource {
  id         String        @id @default(cuid())
  clientId   String
  resourceId String
  metadata   Json?
  createdAt  DateTime?
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauth_client_resource")
}

model OauthRefreshToken {
  id                      String             @id @default(cuid())
  token                   String             @unique
  clientId                String
  sessionId               String?
  userId                  String
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime?
  createdAt               DateTime?
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens            OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_token")
}

model OauthAccessToken {
  id                      String             @id @default(cuid())
  token                   String?            @unique
  clientId                String
  sessionId               String?
  userId                  String?
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?
  expiresAt               DateTime?
  createdAt               DateTime?
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh                 OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id                      String      @id @default(cuid())
  clientId                String
  userId                  String?
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime?
  updatedAt               DateTime?
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}

// One row per private_key_jwt assertion, so each is used once. Unused by the lab (it authenticates with a secret).
model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauth_client_assertion")
}

// ---------------------------------------------------------------------------------------------------------------
// The practice engine's skill graph (docs/practice.md). An admin drafts each lesson's skills with a model, edits and
// approves them on /admin/practice, then publishes: a SkillGraphVersion snapshots the approved skills and their
// prerequisites as an lk-practice graph, which learners' practice is planned against.
// ---------------------------------------------------------------------------------------------------------------

// lk-practice's two default ladders: declarative (recognise, recall, produce, apply) and procedural (example,
// complete, write, transfer).
enum SkillKnowledge {
  DECLARATIVE
  PROCEDURAL
}

// HARD: the skill is locked until the prerequisite is mastered. SOFT: practised first when both are due.
enum SkillEdgeStrength {
  HARD
  SOFT
}

enum SkillDraftStatus {
  DRAFTED
  APPROVED
}

// A skill in the working graph, taught by one lesson.
model PracticeSkill {
  id            String              @id @default(cuid())
  courseId      String
  lessonId      String
  // The graph's id for it: kebab-case, unique in the course, kept across versions so learners' history follows it.
  key           String
  labelEs       String
  labelEn       String
  descriptionEs String
  descriptionEn String
  knowledge     SkillKnowledge
  // Code tasks can practise it offline: plain Python and the course's packages, no network or API keys. When false,
  // it gets recall tasks only.
  runnable      Boolean             @default(true)
  // How a grader can tell this skill apart in an answer (lk-practice's criteriaHint).
  criteriaHint  String?
  // Order within the lesson.
  position      Int
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  course        Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson        Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  // Edges where this skill is the prerequisite, and where it needs one.
  requiredBy    PracticeSkillEdge[] @relation("EdgeFrom")
  requires      PracticeSkillEdge[] @relation("EdgeTo")

  @@unique([courseId, key])
  @@index([lessonId, position])
  @@map("practice_skill")
}

// `from` must be learned before `to`.
model PracticeSkillEdge {
  id        String            @id @default(cuid())
  fromId    String
  toId      String
  strength  SkillEdgeStrength
  // The drafting model's reason, for the reviewer.
  reason    String?
  createdAt DateTime          @default(now())
  from      PracticeSkill     @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        PracticeSkill     @relation("EdgeTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId])
  @@map("practice_skill_edge")
}

// A lesson's place in the review: drafted by a model, then approved by an admin. Only approved lessons are published.
model PracticeLessonDraft {
  id           String           @id @default(cuid())
  lessonId     String           @unique
  status       SkillDraftStatus @default(DRAFTED)
  // The model that wrote the draft, and its trace in the logs.
  model        String?
  traceId      String?
  draftedAt    DateTime         @default(now())
  approvedAt   DateTime?
  approvedById String?
  lesson       Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("practice_lesson_draft")
}

// A published graph: the approved skills and prerequisites at that moment, as lk-practice's SkillGraph (version
// "<course slug>@<version>") plus each skill's labels and lesson. Never edited; the next publish adds a version.
model SkillGraphVersion {
  id            String   @id @default(cuid())
  courseId      String
  version       Int
  graph         Json
  skillCount    Int
  edgeCount     Int
  publishedAt   DateTime @default(now())
  publishedById String?
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, version])
  @@map("skill_graph_version")
}

// A practice task in a skill's pool (docs/practice.md, "Tasks"): written by a model for one skill and stage, then
// proven before any learner sees it (code: the reference passes on the grader and wrong code fails; questions: a
// second model answers it blind and agrees with the key). Rejected candidates are kept with their reason, to tune the
// prompt. Tasks follow the skill's key, so they survive new graph versions.
enum PracticeTaskStatus {
  PROVEN
  REJECTED
  RETIRED
}

model PracticeTask {
  id              String             @id @default(cuid())
  courseId        String
  skillKey        String
  // A stage of the skill's ladder (recognise, recall, produce, apply; example, complete, write, transfer).
  stage           String
  // choice, fill, predict, code or debug.
  form            String
  // lk-practice's difficulty, in logits relative to the stage (about -1 easy to +1 hard).
  difficulty      Float              @default(0)
  expectedSeconds Int
  // What the learner sees and the key (lib/practice/tasks.ts TaskContent), in Spanish and English.
  content         Json
  // The lk-practice item once proven (status "proven", with its proof); null while rejected.
  item            Json?
  status          PracticeTaskStatus
  rejectReason    String?
  // The model that wrote it, and the call's trace in the logs.
  model           String
  traceId         String?
  contentHash     String
  // An admin's edit makes a new task (proven again) and retires this one: the task it replaced.
  editedFromId    String?
  createdAt       DateTime           @default(now())
  course          Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  answers         PracticeAnswer[]
  hints           PracticeHint[]

  @@unique([courseId, contentHash])
  @@index([courseId, skillKey, stage, status])
  @@map("practice_task")
}

// A learner's practice in one course (docs/practice.md, "A session"). lk-practice's state is a cache of the log: the
// log is the truth, and a new graph version is applied by replaying it.
model PracticeLearner {
  id           String              @id @default(cuid())
  userId       String
  courseId     String
  // The published graph version the state is built on.
  graphVersion Int
  state        Json
  // This learner's confirmed missing prerequisites (lk-practice DiscoveryExtension[]): their graph is the published
  // one composed with these (docs/practice.md, "Missing prerequisites").
  extensions   Json                @default("[]")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  log          PracticeLogEntry[]
  sessions     PracticeSession[]
  diagnoses    PracticeDiagnosis[]

  @@unique([userId, courseId])
  @@map("practice_learner")
}

// lk-practice's append-only log (ReviewLogEntry), in order.
model PracticeLogEntry {
  id        String          @id @default(cuid())
  learnerId String
  seq       Int
  entry     Json
  at        DateTime
  learner   PracticeLearner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([learnerId, seq])
  @@map("practice_log_entry")
}

// One day's practice for a learner: the planned tasks, in order. "A few more" after the daily set is another session
// marked extra.
model PracticeSession {
  id          String           @id @default(cuid())
  learnerId   String
  // The learner's own date (YYYY-MM-DD, in their time zone).
  day         String
  extra       Boolean          @default(false)
  // [{ targetId, taskId, skillKey, stage, kind }] (lib/practice/learner.ts SessionItem).
  items       Json
  createdAt   DateTime         @default(now())
  completedAt DateTime?
  learner     PracticeLearner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  answers     PracticeAnswer[]
  hints       PracticeHint[]

  @@index([learnerId, day])
  @@map("practice_session")
}

// A learner's answer to one task, with what the page showed them back.
model PracticeAnswer {
  id         String          @id @default(cuid())
  sessionId  String
  taskId     String
  answer     Json
  passed     Boolean
  score      Float
  durationMs Int
  // The grading the learner saw: tests and their messages, output, or the key.
  result     Json
  createdAt  DateTime        @default(now())
  session    PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  task       PracticeTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([sessionId, taskId])
  @@map("practice_answer")
}

// Missing prerequisites (docs/practice.md): when a learner fails a skill twice in a row, a model names the
// prerequisites that may be missing, and lk-practice tests each with short probes.

enum PracticeDiagnosisStatus {
  PENDING
  RUNNING
  // At least one hypothesis opened.
  OPENED
  // The model found nothing missing, or nothing it proposed passed the checks.
  NONE
  FAILED
}

// One diagnosis of a failed skill: asked for after the answer, run by the practice page in the background.
model PracticeDiagnosis {
  id         String                  @id @default(cuid())
  learnerId  String
  // The failed answer's evidence id (the practice answer's id).
  evidenceId String                  @unique
  skillKey   String
  stage      String
  taskId     String
  status     PracticeDiagnosisStatus @default(PENDING)
  model      String?
  // What the model proposed: accepted ones with lk-practice's hypothesis id, rejected ones with the check's codes.
  proposals  Json?
  error      String?
  createdAt  DateTime                @default(now())
  finishedAt DateTime?
  learner    PracticeLearner         @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId, createdAt])
  @@map("practice_diagnosis")
}

// A skill the course doesn't teach that a diagnosis named (key "found.<name>"), shared by the course's learners so
// its tasks are written once.
model PracticeFoundSkill {
  id            String           @id @default(cuid())
  courseId      String
  key           String
  labelEs       String
  labelEn       String
  descriptionEs String
  descriptionEn String
  knowledge     SkillKnowledge
  runnable      Boolean          @default(true)
  // lk-practice's SkillNode for it, as hypotheses carry it (its content is part of their ids).
  node          Json
  // The lesson of the skill it was first found for: where the map and the task writer place it.
  lessonId      String
  // Who found it: a practice diagnosis, or the tutor (a detour or a learner asking for practice).
  origin        FoundSkillOrigin @default(DIAGNOSIS)
  // For a tutor's skill, what the tutor's challenge looked like: its tasks are written in the same spirit.
  context       String?
  createdAt     DateTime         @default(now())
  course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, key])
  @@map("practice_found_skill")
}

enum FoundSkillOrigin {
  DIAGNOSIS
  TUTOR
}

enum DiscoveredEdgeStatus {
  PROPOSED
  // Added to the course's own graph (a skill and a prerequisite on /admin/practice; published with the next version).
  ADDED
  // Not proposed again.
  DISMISSED
}

// A prerequisite a diagnosis proposed (from -> to), with how its probes went across learners.
model PracticeDiscoveredEdge {
  id        String               @id @default(cuid())
  courseId  String
  fromKey   String
  toKey     String
  status    DiscoveredEdgeStatus @default(PROPOSED)
  // The first model's reason, shown to the admin.
  rationale String?
  opened    Int                  @default(0)
  confirmed Int                  @default(0)
  refuted   Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  course    Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, fromKey, toKey])
  @@map("practice_discovered_edge")
}

// A hint a learner asked for on a task before answering it (docs/practice.md, "Hints"): at most three a task, each
// more specific than the last. Their number goes into the answer's evidence (lk-practice's hintsUsed).
model PracticeHint {
  id        String          @id @default(cuid())
  sessionId String
  taskId    String
  // 1, 2 or 3.
  number    Int
  text      String
  model     String
  createdAt DateTime        @default(now())
  session   PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  task      PracticeTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([sessionId, taskId, number])
  @@map("practice_hint")
}

// Python Compass (docs/compass.md): a card for each Python concept learners meet in the course, grounded in the official
// docs and proven on the grader, and the signals that show which cards learners need most. `language` is "python" for
// now; the same tables hold other languages' concepts later.

enum CompassCardStatus {
  // Written (by a model or by hand), not proven yet.
  DRAFT
  // Its examples ran on the grader as the card says; waiting for the admin's review.
  PROVEN
  // Learners see it (one published version per concept).
  PUBLISHED
  // Replaced by a newer version, or taken down.
  RETIRED
}

enum CompassSignalKind {
  // A search: what was typed, and whether it found anything (a search that found nothing says what to write next).
  SEARCH
  CARD_VIEW
  // "Explain this line" on a construct.
  EXPLAIN_LINE
  // A learner's code raised (scratchbook, code tasks): the error type, and the concept on the failing line.
  RUN_ERROR
  // A question to the guide's AI.
  ASK
  // A practice answer missed on a task that practises the concept.
  PRACTICE_MISS
}

// One concept the detector knows (lib/compass/detector.py), with what the course asks of it.
model CompassConcept {
  id          String        @id @default(cuid())
  language    String        @default("python")
  // The detector's key, stable across versions: "f-string", "dict-get", "stdlib:json".
  key         String
  group       String
  labelEs     String
  labelEn     String
  // From the course inventory (scripts/compass-inventory.py): the cards' starting order, how many lessons teach with
  // it, and the lesson where it first appears.
  usageRank   Int?
  lessonCount Int           @default(0)
  firstLesson String?
  // From learners' signals, recomputed: how much learners need it. It re-ranks the cards over time.
  demand      Float         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  cards       CompassCard[]

  @@unique([language, key])
  @@index([language, usageRank])
  @@map("compass_concept")
}

// A version of a concept's card. An edit makes a new version, proven again; publishing it retires the previous one.
model CompassCard {
  id            String            @id @default(cuid())
  conceptId     String
  version       Int
  status        CompassCardStatus @default(DRAFT)
  // What its examples ran on: "3.12" (Python), or "Node.js 26.13.1, TypeScript 7.0.2" (JavaScript). The column keeps
  // its first name, pythonVersion, so no migration is needed.
  runtimeVersion String           @default("3.12") @map("pythonVersion")
  // What the learner reads, in Spanish and English: title, one-line summary, the explanation (Markdown), when to reach
  // for it, and the LangChain lessons where it shows up.
  content       Json
  // Runnable examples (the code and the output it must print) and common mistakes (code that must fail with the error
  // the card names), all checked on the grader.
  examples      Json
  // Official docs links, each one in the docs index (lib/compass/python-docs-<version>.json): never an invented URL.
  docs          Json
  // Concept keys it builds on and leads to.
  related       String[]
  // The grader's results for its examples and mistakes, when proven.
  proof         Json?
  // Who wrote this version: a model id, or "admin".
  author        String
  reviewedById  String?
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  concept       CompassConcept    @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([conceptId, version])
  @@index([status])
  @@map("compass_card")
}

// What learners do and where they struggle, collected from day one so the cards can be ranked by need, not guesses.
// Counted, never shown by name.
model CompassSignal {
  id         String            @id @default(cuid())
  kind       CompassSignalKind
  // The learner, when signed in: to count distinct learners.
  userId     String?
  language   String            @default("python")
  conceptKey String?
  // What was searched or asked (trimmed), or the error type of a RUN_ERROR.
  text       String?
  // A search that found nothing.
  empty      Boolean           @default(false)
  // Where it happened: "scratchbook", "practice", "lesson", "guide".
  surface    String?
  courseId   String?
  createdAt  DateTime          @default(now())

  @@index([kind, createdAt])
  @@index([conceptKey, kind])
  @@map("compass_signal")
}

// Bulk practice work (docs/practice.md, "Jobs"): writing every missing task, or drafting every remaining lesson. The
// admin page starts a job; the practice worker on the lab server (services/practice-worker) carries out its items one
// by one, with no request time limit, retries what fails for a passing reason, and keeps going until every item is
// done or the admin stops it. The page only shows the progress, so it can be closed.

enum PracticeJobKind {
  WRITE_TASKS
  DRAFT_LESSONS
}

enum PracticeJobStatus {
  // Waiting for the worker to pick it up.
  QUEUED
  RUNNING
  // The admin pressed Stop: the worker finishes the items in progress, then stops.
  STOPPING
  STOPPED
  DONE
  // Something every later item would hit too (a spent allowance): the reason is in `error`.
  HALTED
}

enum PracticeJobItemStatus {
  PENDING
  RUNNING
  // Written and proven, or drafted.
  OK
  // A real outcome: the task didn't pass its proof (kept, rejected, under its skill).
  REJECTED
  // Failed every attempt for a passing reason (a model or the grader didn't answer).
  FAILED
}

model PracticeJob {
  id          String            @id @default(cuid())
  courseId    String
  kind        PracticeJobKind
  status      PracticeJobStatus @default(QUEUED)
  // The model a draft starts with (DRAFT_LESSONS); tasks use the task writer's own choice.
  model       String?
  // Items worked on at the same time.
  concurrency Int               @default(2)
  createdById String
  // Why a halted job halted.
  error       String?
  // The worker's last sign of life on this job: the page warns when it goes quiet.
  heartbeatAt DateTime?
  createdAt   DateTime          @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  items       PracticeJobItem[]

  @@index([status, createdAt])
  @@index([courseId, createdAt])
  @@map("practice_job")
}

model PracticeJobItem {
  id         String                @id @default(cuid())
  jobId      String
  position   Int
  // WRITE_TASKS: the skill and the stage to write a task for. DRAFT_LESSONS: the lesson to draft.
  skillKey   String?
  stage      String?
  lessonId   String?
  // What the page calls it ("llm-system-vs-api-call · apply", "00.04").
  label      String
  status     PracticeJobItemStatus @default(PENDING)
  attempts   Int                   @default(0)
  // A retried item waits until then.
  notBefore  DateTime?
  // What happened: the proof's note, or why it was rejected or failed.
  result     String?
  model      String?
  startedAt  DateTime?
  finishedAt DateTime?
  job        PracticeJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, status, position])
  @@map("practice_job_item")
}

// A whiteboard session (docs/whiteboard.md): one learner learning one skill, or one lesson with no skills yet, with
// Didactra, the teacher that talks and draws (docs/whiteboard-contract.md). Didactra keeps the board, the transcript and
// the replay; the platform keeps who, what, how long, what it cost, and the summary.
model BoardSession {
  id              String               @id @default(cuid())
  userId          String
  courseId        String
  lessonId        String
  // The skill's key (PracticeSkill.key); null for a session on a whole lesson.
  skillKey        String?
  // "es" or "en".
  language        String
  // Didactra's own id for its session (12 hex), from its "started" event.
  didactraSession String?
  status          BoardSessionStatus   @default(OPEN)
  minutes         Float                @default(0)
  costUsd         Float                @default(0)
  model           String?
  voice           String?
  // The "ended" event's summary: taught, learnerDid, struggles, readyToPractise, profileNotes.
  summary         Json?
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson          Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  events          BoardSessionEvent[]

  @@index([userId, lessonId, skillKey, createdAt])
  @@index([courseId, createdAt])
  @@map("board_session")
}

enum BoardSessionStatus {
  OPEN
  ENDED
}

// An event Didactra sent about a session, kept by its id so a retried event is applied once.
model BoardSessionEvent {
  id        String       @id @default(cuid())
  sessionId String
  eventId   String
  type      String
  // What the platform answered, for an event that answers with a body (a preference): sent again for a retry.
  result    Json?
  createdAt DateTime     @default(now())
  session   BoardSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, eventId])
  @@map("board_session_event")
}

// One of the learner's own instructions for how to teach them, kept word for word: never rewritten by a model
// (docs/whiteboard-teaching.md §2). Unlike the learner profile's notes (what the teachers observed), these are what the
// learner asked for, and they outrank the notes. "all": every teacher reads it; "board": only the whiteboard's.
model LearnerPreference {
  id        String   @id @default(cuid())
  userId    String
  scope     String
  text      String
  // Who saved it: "board" (the whiteboard's teacher), "learner" (on the How I learn page), later "voice".
  source    String
  // The whiteboard session it was said in, when it came from one.
  sessionId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scope, createdAt])
  @@map("learner_preference")
}
