# Copy to .env.local (git-ignored). It overrides .env for `next dev`, `next build` and the Prisma CLI, so local
# development and migrations use the database from infra/dev/compose.yaml instead of production.
# Delete .env.local to point local development back at production.
DATABASE_URL=postgresql://academia:academia-dev@localhost:5433/academia
DIRECT_URL=postgresql://academia:academia-dev@localhost:5433/academia

# Course media (lib/media.ts). Leave these unset locally: /media/... paths are then served from public/media
# (git-ignored), so a lesson video can be tried before it is uploaded. Set all three to try the real CloudFront
# signing from your PC (values from infra/media/README.md).
# MEDIA_BASE_URL=https://media.academiadelcodigo.com
# MEDIA_KEY_PAIR_ID=
# MEDIA_PRIVATE_KEY_B64=

# Uploading lesson videos from /admin/videos (actions/videos.ts). The AWS SDK signs with this profile; on Amplify the
# app's compute role does it. Values from infra/media/README.md, step 5.
# AWS_PROFILE=dalejo
# MEDIA_BUCKET=academia-course-media-836287555131
# MEDIA_CONVERT_ROLE_ARN=arn:aws:iam::836287555131:role/academia-media-mediaconvert
