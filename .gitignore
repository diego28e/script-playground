# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!infra/lab/.env.example
!infra/lab/learning/.env.example
!infra/lab/grader/.env.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# course media tried locally before upload (lib/media.ts)
/public/media/

# The learning service bundle and schema copy, built by pnpm learning:build
/infra/lab/learning/dist/
/infra/lab/learning/schema.prisma

# The tutor panel's local build (the student image rebuilds it: infra/lab/Dockerfile)
/infra/lab/tutor/labextension/node_modules/
/infra/lab/tutor/labextension/lib/
/infra/lab/tutor/labextension/tsconfig.tsbuildinfo
/infra/lab/tutor/academia_tutor/labextension/
__pycache__/
